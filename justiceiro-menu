btnShoot.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool or not nomeNaLista(tool.Name, NOMES_ARMA) then
        btnShoot.Text = "SEM ARMA"; task.wait(0.5); btnShoot.Text = "SHOOT" return
    end
    local alvo, menorDist, hrp = nil, 9999, char:FindFirstChild("HumanoidRootPart")
    for _, j in ipairs(Players:GetPlayers()) do
        if j ~= LocalPlayer and j.Character and detectarPapel(j) == "Murderer" then
            local alvoHrp = j.Character:FindFirstChild("HumanoidRootPart")
            if alvoHrp and hrp then
                local dist = (alvoHrp.Position - hrp.Position).Magnitude
                if dist < menorDist then menorDist = dist; alvo = alvoHrp end
            end
        end
    end
    if alvo then
        local camera = workspace.CurrentCamera
        local cfOriginal = camera.CFrame
        camera.CFrame = CFrame.new(cfOriginal.Position, alvo.Position)
        local centerPos = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        VirtualInputManager:SendMouseButtonEvent(centerPos.X, centerPos.Y, 0, true, game, 1)
        tool:Activate()
        VirtualInputManager:SendMouseButtonEvent(centerPos.X, centerPos.Y, 0, false, game, 1)
        task.defer(function() task.wait(0.1); camera.CFrame = cfOriginal end)
        btnShoot.Text = "TIROU!"; task.wait(0.2); btnShoot.Text = "SHOOT"
    else
        btnShoot.Text = "SEM ALVO"; task.wait(0.5); btnShoot.Text = "SHOOT"
    end
end)

