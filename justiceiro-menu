local btnShoot = novo("TextButton", {
    Size = UDim2.new(0, 100, 0, 50), Position = UDim2.new(1, -120, 0.5, 0),
    BackgroundColor3 = Color3.fromRGB(255,255,255), Text = "SHOOT",
    TextColor3 = CORES.Fundo, Font = Enum.Font.GothamBlack, TextSize = 20, Visible = false,
}, screenGui)
cantos(btnShoot, 6); stroke(btnShoot, CORES.Neon, 0.5)

btnShoot.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool or not nomeNaLista(tool.Name, NOMES_ARMA) then
        btnShoot.Text = "SEM ARMA"; task.wait(0.5); btnShoot.Text = "SHOOT"; return
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local camera = workspace.CurrentCamera
    local alvo, melhorDist = nil, math.huge
    for _, j in ipairs(Players:GetPlayers()) do
        if j ~= LocalPlayer and j.Character and detectarPapel(j) == "Murderer" then
            local alvoHrp = j.Character:FindFirstChild("HumanoidRootPart")
            if alvoHrp then
                local d = (alvoHrp.Position - hrp.Position).Magnitude
                if d < melhorDist then melhorDist = d; alvo = alvoHrp end
            end
        end
    end

    if not alvo then
        btnShoot.Text = "SEM ALVO"; task.wait(0.5); btnShoot.Text = "SHOOT"; return
    end

    local posTela, onScreen = camera:WorldToViewportPoint(alvo.Position)
    if not onScreen then
        local centro = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        local dir = (Vector2.new(posTela.X, posTela.Y) - centro)
        if dir.Magnitude > 0 then
            local edge = centro + dir.Unit * math.min(camera.ViewportSize.X, camera.ViewportSize.Y) * 0.4
            posTela = Vector3.new(edge.X, edge.Y, posTela.Z)
        end
    end

    local screenX = math.clamp(posTela.X, 1, camera.ViewportSize.X - 1)
    local screenY = math.clamp(posTela.Y, 1, camera.ViewportSize.Y - 1)

    pcall(function() tool:Activate() end)
    VirtualInputManager:SendMouseButtonEvent(screenX, screenY, 0, true,  game, 1)
    VirtualInputManager:SendMouseButtonEvent(screenX, screenY, 0, false, game, 1)

    btnShoot.Text = "TIROU!"
    task.wait(0.2)
    btnShoot.Text = "SHOOT"
end)

