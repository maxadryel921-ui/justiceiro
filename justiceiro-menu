local function limpar()
    for _, hl in pairs(destaques) do if hl.Parent then hl:Destroy() end end; destaques = {}
    for _, bb in pairs(billboards) do if bb.Parent then bb:Destroy() end end; billboards = {}
end
local function aplicar(jogador)
    if jogador == LocalPlayer then return end
    local char = jogador.Character; if not char or not char:FindFirstChildOfClass("Humanoid") then return end
    if destaques[jogador] then destaques[jogador]:Destroy() end; if billboards[jogador] then billboards[jogador]:Destroy() end
    local papel = detectarPapel(jogador)
    local hl = Instance.new("Highlight"); hl.Adornee = char; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor = CORES[papel]; hl.OutlineColor = CORES[papel]; hl.FillTransparency = 0.6; hl.Parent = char; destaques[jogador] = hl
    local head = char:FindFirstChild("Head")
    if head then
        local bb = Instance.new("BillboardGui"); bb.Adornee = head; bb.Size = UDim2.new(0,100,0,20); bb.StudsOffset = Vector3.new(0,2,0); bb.AlwaysOnTop = true; bb.Parent = head
        local txt = Instance.new("TextLabel"); txt.Size = UDim2.new(1,0,1,0); txt.BackgroundTransparency = 1; txt.Text = jogador.Name; txt.TextColor3 = CORES[papel]; txt.Font = Enum.Font.GothamBold; txt.TextSize = 10; txt.Parent = bb
        billboards[jogador] = bb
    end
end
function atualizarTudo() limpar(); if not state.espAtivo then return end; for _, j in ipairs(Players:GetPlayers()) do aplicar(j) end end

