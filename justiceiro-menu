local function criarBotao(parent, texto, ordem, callback)
    local btn = novo("TextButton", {
        Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = CORES.Botao,
        Text = texto, TextColor3 = CORES.Texto, Font = Enum.Font.GothamBlack, TextSize = 13, LayoutOrder = ordem,
    }, parent)
    cantos(btn, 4)
    btn.MouseButton1Click:Connect(callback)
    btn.MouseEnter:Connect(function() TweenService:Create(btn, TweenInfo.new(0.1), { BackgroundColor3 = Color3.fromRGB(40,40,40) }):Play() end)
    btn.MouseLeave:Connect(function() TweenService:Create(btn, TweenInfo.new(0.1), { BackgroundColor3 = CORES.Botao }):Play() end)
    return btn
end

