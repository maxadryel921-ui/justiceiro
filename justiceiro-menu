-- ================= HELPERS =================
local function novo(classe, props, parent)
    local o = Instance.new(classe)
    for k, v in pairs(props or {}) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end
local function cantos(obj, r) novo("UICorner", { CornerRadius = UDim.new(0, r or 4) }, obj) end
local function stroke(obj, cor, trans) novo("UIStroke", { Color = cor or Color3.fromRGB(40, 40, 40), Thickness = 1, Transparency = trans or 0 }, obj) end

local function nomeNaLista(nome, lista)
    for _, n in ipairs(lista) do
        if string.find(string.lower(nome), string.lower(n), 1, true) then return true end
    end
    return false
end

local function classificarTool(tool)
    if nomeNaLista(tool.Name, NOMES_FACA) then return "Murderer" end
    if nomeNaLista(tool.Name, NOMES_ARMA) then return "Sheriff" end
    return nil
end

local function detectarPapel(jogador)
    local char = jogador.Character
    local backpack = jogador:FindFirstChildOfClass("Backpack")
    if char then
        for _, obj in ipairs(char:GetChildren()) do
            if obj:IsA("Tool") then
                local p = classificarTool(obj); if p then return p end
            end
        end
    end
    if backpack then
        for _, obj in ipairs(backpack:GetChildren()) do
            if obj:IsA("Tool") then
                local p = classificarTool(obj); if p then return p end
            end
        end
    end
    return "Innocent"
end

