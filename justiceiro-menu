-- ================= ESP =================
local function limpar()
    for _, hl in pairs(destaques) do if hl and hl.Parent then hl:Destroy() end end
    for _, bb in pairs(billboards) do if bb and bb.Parent then bb:Destroy() end end
    destaques, billboards = {}, {}
end

local function aplicar(jogador)
    if jogador == LocalPlayer then return end
    local char = jogador.Character
    if not char or not char:FindFirstChildOfClass("Humanoid") then return end
    if destaques[jogador] and destaques[jogador].Parent then destaques[jogador]:Destroy() end
    if billboards[jogador] and billboards[jogador].Parent then billboards[jogador]:Destroy() end
    destaques[jogador], billboards[jogador] = nil, nil

    local papel = detectarPapel(jogador)
    if papel == "Innocent" and not state.mostrarInnocent then return end
    if papel == "Sheriff"  and not state.mostrarSheriff  then return end
    if papel == "Murderer" and not state.mostrarMurderer then return end

    local hl = novo("Highlight", {
        Name = "ESP_Highlight", Adornee = char, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
        FillColor = CORES[papel], OutlineColor = CORES[papel],
        FillTransparency = 0.6, OutlineTransparency = 0,
    }, char)
    destaques[jogador] = hl

    if state.mostrarNomes then
        local head = char:FindFirstChild("Head")
        if head then
            local bb = novo("BillboardGui", {
                Name = "ESP_Nome", Adornee = head, Size = UDim2.new(0, 100, 0, 20),
                StudsOffset = Vector3.new(0, 2, 0), AlwaysOnTop = true,
            }, head)
            novo("TextLabel", {
                Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
                Text = jogador.Name, TextColor3 = CORES[papel],
                Font = Enum.Font.GothamBold, TextSize = 10,
                TextStrokeTransparency = 0.3, TextStrokeColor3 = Color3.fromRGB(0,0,0),
            }, bb)
            billboards[jogador] = bb
        end
    end
end

function atualizarTudo()
    limpar()
    if not state.espAtivo then return end
    for _, j in ipairs(Players:GetPlayers()) do aplicar(j) end
end

-- ================= LOOPS PRINCIPAIS =================
task.spawn(function()
    while true do
        task.wait(0.2)
        if state.espAtivo then
            for _, j in ipairs(Players:GetPlayers()) do
                if j ~= LocalPlayer and j.Character then
                    local hl = destaques[j]
                    local papelAtual = detectarPapel(j)
                    if not hl or not hl.Parent or hl.Parent ~= j.Character or hl.FillColor ~= CORES[papelAtual] then
                        aplicar(j)
                    end
                end
            end
        end

        if state.godModeAtivo then
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health < 100 then hum.Health = 100 end
        end

        if state.hitboxAtivo then
            for _, j in ipairs(Players:GetPlayers()) do
                if j ~= LocalPlayer and j.Character and detectarPapel(j) == "Murderer" then
                    local hrp = j.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        if not hitboxesCriadas[j] or not hitboxesCriadas[j].Parent then
                            local caixa = novo("Part", {
                                Size = Vector3.new(15,15,15), Transparency = 0.8, Color = CORES.Murderer,
                                CanCollide = false, CanTouch = true, CanQuery = true, Massless = true, Anchored = true,
                                Parent = workspace,
                            })
                            hitboxesCriadas[j] = caixa
                        end
                        hitboxesCriadas[j].CFrame = hrp.CFrame
                    end
                end
            end
        end

        if state.antiFlingAtivo then
            for _, j in ipairs(Players:GetPlayers()) do
                if j ~= LocalPlayer and j.Character then
                    for _, parte in ipairs(j.Character:GetDescendants()) do
                        if parte:IsA("BasePart") then parte.CanCollide = false end
                    end
                end
            end
        end
    end
end)

RunService.Stepped:Connect(function()
    if state.noclipAtivo then
        local char = LocalPlayer.Character
        if char then
            for _, parte in ipairs(char:GetDescendants()) do
                if parte:IsA("BasePart") then parte.CanCollide = false end
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(0.2)
        if state.farmAtivo then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local parts = workspace:GetPartBoundsInRadius(hrp.Position, RAIO_AURA)
                for _, item in ipairs(parts) do
                    if item.Parent and nomeNaLista(item.Name, NOMES_FARM) then
                        firetouchinterest(item, hrp, 0)
                        firetouchinterest(item, hrp, 1)
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(1)
        if state.vooAtivo then
            local lista = {}
            for _, obj in ipairs(workspace:GetChildren()) do
                if obj:IsA("BasePart") and nomeNaLista(obj.Name, NOMES_FARM) then
                    table.insert(lista, obj)
                else
                    for _, sub in ipairs(obj:GetChildren()) do
                        if sub:IsA("BasePart") and nomeNaLista(sub.Name, NOMES_FARM) then
                            table.insert(lista, sub)
                        end
                    end
                end
            end
            cacheItensFarm = lista
        end
    end
end)

RunService.Heartbeat:Connect(function()
    if not state.vooAtivo then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = false end
    end

    if alvoAtual and (not alvoAtual.Parent or not alvoAtual:IsDescendantOf(workspace)) then
        alvoAtual = nil
        if bodyVelocity then bodyVelocity.Velocity = Vector3.zero end
    end

    if not alvoAtual then
        local menor = math.huge
        for _, obj in ipairs(cacheItensFarm) do
            if obj and obj.Parent then
                local d = (obj.Position - hrp.Position).Magnitude
                if d < menor then menor = d; alvoAtual = obj end
            end
        end
    end

    if alvoAtual then
        local dist = (alvoAtual.Position - hrp.Position).Magnitude
        if dist < 5 then
            firetouchinterest(alvoAtual, hrp, 0)
            firetouchinterest(alvoAtual, hrp, 1)
            alvoAtual = nil
            if bodyVelocity then bodyVelocity.Velocity = Vector3.zero end
        else
            if not bodyVelocity or not bodyVelocity.Parent then
                bodyVelocity = novo("BodyVelocity", {
                    MaxForce = Vector3.new(math.huge, math.huge, math.huge),
                    Parent = hrp,
                })
            end
            local direcao = (alvoAtual.Position - hrp.Position).Unit
            bodyVelocity.Velocity = direcao * state.veloFarm
            hum.PlatformStand = false
        end
    else
        if bodyVelocity then bodyVelocity.Velocity = Vector3.zero end
    end
end)

