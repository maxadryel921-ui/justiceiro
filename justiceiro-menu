-- Loop de Aura
task.spawn(function()
    while true do
        task.wait(0.2)
        if state.farmAtivo then
            local char = LocalPlayer.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local partsInRadius = workspace:GetPartBoundsInRadius(hrp.Position, RAIO_AURA)
                    for _, item in ipairs(partsInRadius) do
                        if item.Parent and nomeNaLista(item.Name, NOMES_FARM) then
                            firetouchinterest(item, hrp, 0); firetouchinterest(item, hrp, 1)
                        end
                    end
                end
            end
        end
    end
end)

-- Loop do Auto Farm (Voo)
RunService.Heartbeat:Connect(function()
    if state.vooAtivo then
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end

        for _, p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end

        if alvoAtual and not alvoAtual.Parent then
            alvoAtual = nil; if bodyVelocity then bodyVelocity.Velocity = Vector3.new(0, 0, 0) end
        end

        if not alvoAtual then
            local menorDist = 9999
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and obj.Parent and nomeNaLista(obj.Name, NOMES_FARM) then
                    local dist = (obj.Position - hrp.Position).Magnitude
                    if dist < menorDist then menorDist = dist; alvoAtual = obj end
                end
            end
        end

        if alvoAtual then
            local dist = (alvoAtual.Position - hrp.Position).Magnitude
            if dist < 5 then
                firetouchinterest(alvoAtual, hrp, 0); firetouchinterest(alvoAtual, hrp, 1)
                alvoAtual = nil; if bodyVelocity then bodyVelocity.Velocity = Vector3.new(0, 0, 0) end
                task.wait(0.1)
            else
                if not bodyVelocity or not bodyVelocity.Parent then
                    bodyVelocity = Instance.new("BodyVelocity")
                    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    bodyVelocity.Parent = hrp
                end
                local direcao = (alvoAtual.Position - hrp.Position).Unit
                bodyVelocity.Velocity = direcao * state.veloFarm
                hum.PlatformStand = false; hum:ChangeState(Enum.HumanoidStateType.Physics)
            end
        else
            if bodyVelocity then bodyVelocity.Velocity = Vector3.new(0, 0, 0) end
        end
    end
end)

