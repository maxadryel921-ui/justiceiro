-- ================= HELPERS =================
local function novo(classe, props, parent)
    local o = Instance.new(classe)
    for k, v in pairs(props or {}) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end
local function cantos(obj, r) novo("UICorner", { CornerRadius = UDim.new(0, r or 4) }, obj) end
local function stroke(obj, cor, trans) novo("UIStroke", { Color = cor or Color3.fromRGB(40,40,40), Thickness = 1, Transparency = trans or 0 }, obj) end

local function nomeNaLista(nome, lista)
    for _, n in ipairs(lista) do
        if string.find(string.lower(nome), string.lower(n), 1, true) then return true end
    end
    return false
end

local function classificarTool(tool)
    if nomeNaLista(tool.Name, NOMES_FACA) then return "Murderer" end
    if nomeNaLista(tool.Name, NOMES_ARMA) then return "Sheriff" end
    return nil
end

local function detectarPapel(jogador)
    local c = cachePapel[jogador]
    if c and (tick() - c.t) < 0.6 then return c.papel end
    local papel = "Innocent"
    local char = jogador.Character
    local backpack = jogador:FindFirstChildOfClass("Backpack")
    local function check(container)
        if not container then return false end
        for _, obj in ipairs(container:GetChildren()) do
            if obj:IsA("Tool") then
                local p = classificarTool(obj)
                if p then papel = p; return true end
            end
        end
        return false
    end
    if not (char and check(char)) then check(backpack) end
    cachePapel[jogador] = { papel = papel, t = tick() }
    return papel
end

-- ================= SISTEMA DE ARRASTAR =================
local function tornarArrastavel(frame, dragArea)
    local dragging, dragStart, startPos = false, nil, nil
    dragArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
end

